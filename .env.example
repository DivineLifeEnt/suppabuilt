# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_TRUST_HOST=true

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/suppabuilt

# Realtime — set fake for local dev (no Pusher credentials needed)
REALTIME_PROVIDER=fake
REALTIME_APP_ID=
REALTIME_KEY=
REALTIME_SECRET=
REALTIME_CLUSTER=mt1

# Dev auth — NEVER true in production
DEV_AUTH_ENABLED=false

# Sprint 6 — Drawing-set version management
# HMAC-SHA256 secret for signing artifact download URLs (generate: openssl rand -hex 32)
ARTIFACT_SECRET=your-artifact-secret-here

# Artifact storage root (defaults to ./storage/artifacts relative to project root)
# ARTIFACT_STORAGE_ROOT=./storage/artifacts

# Maximum PDF upload size in bytes (default: 262144000 = 250 MB)
# MAX_PDF_BYTES=262144000

# Sprint 7 — Estimating & Exports
# Default currency for new estimates
DEFAULT_CURRENCY=USD

# Calculation rounding policy version (must match CALCULATION_POLICY_VERSION in lib/estimating/money.ts)
ESTIMATE_CALCULATION_POLICY_VERSION=1

# Export job runner: "local" (in-process) or "queue" (future: Bull/BullMQ)
EXPORT_JOB_PROVIDER=local

# Max concurrent export workers (local provider only)
EXPORT_WORKER_CONCURRENCY=2

# Timeout for a single export job in seconds
EXPORT_JOB_TIMEOUT_SECONDS=120

# How many days to retain export artifact files
EXPORT_ARTIFACT_RETENTION_DAYS=30

# Maximum pages allowed in a PDF export
EXPORT_MAX_PDF_PAGES=500

# Maximum rows in a spreadsheet export workbook
EXPORT_MAX_WORKBOOK_ROWS=50000

# Maximum export artifact size in megabytes
EXPORT_MAX_ARTIFACT_MB=50
