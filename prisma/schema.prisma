generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  name        String?
  email       String        @unique
  avatarUrl   String?
  markups     Markup[]
  sessions    SessionUser[]
  activities  Activity[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt @default(now())

  orgMemberships        OrganizationMembership[]
  projectMemberships    ProjectMembership[]
  sessionParticipants   SessionParticipant[]
  comments              Comment[]
  assignedComments      Comment[]               @relation("AssignedComments")
  mentionedIn           Mention[]
  auditEvents           AuditEvent[]            @relation("ActorAuditEvents")
}

model Project {
  id            String          @id @default(cuid())
  name          String
  address       String?
  projectNumber String?
  status        String          @default("active")
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  drawings      Drawing[]
  sessions      StudioSession[]
}

model Drawing {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  drawingNumber  String?
  title          String
  discipline     String?
  currentVersion Int              @default(1)
  pageCount      Int              @default(1)
  thumbnailUrl   String?

  versions       DrawingVersion[]
  markups        Markup[]
  measurements   Measurement[]
  scales         DrawingScale[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model DrawingVersion {
  id         String   @id @default(cuid())
  drawingId  String
  drawing    Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  version    Int
  fileUrl    String
  uploadedBy String?
  notes      String?
  uploadedAt DateTime @default(now())

  @@unique([drawingId, version])
}

model StudioSession {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  status    SessionStatus @default(ACTIVE)

  users     SessionUser[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SessionUser {
  id        String        @id @default(cuid())
  sessionId String
  userId    String

  session   StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  userName  String?
  color     String?
  joinedAt  DateTime      @default(now())
  lastSeen  DateTime      @default(now())

  @@unique([sessionId, userId])
}

model Markup {
  id          String       @id @default(cuid())

  drawingId   String
  drawing     Drawing      @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  userId      String
  user        User         @relation(fields: [userId], references: [id])

  page        Int          @default(1)
  type        MarkupType

  x           Float        @default(0)
  y           Float        @default(0)
  width       Float?
  height      Float?
  points      Json?
  text        String?
  color       String       @default("#EF4444")
  strokeWidth Float        @default(2)

  label       String?
  assignedTo  String?
  status      MarkupStatus @default(OPEN)
  comment     String?
  resolvedAt  DateTime?

  metadata    Json?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Measurement {
  id         String          @id @default(cuid())

  drawingId  String
  drawing    Drawing         @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  page       Int             @default(1)
  type       MeasurementType

  points     Json
  value      Float
  unit       String          @default("ft")
  label      String?

  authorName String?
  authorId   String?

  createdAt  DateTime        @default(now())
}

model DrawingScale {
  id              String   @id @default(cuid())
  drawingId       String
  drawing         Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  page            Int      @default(1)
  pixelsPerFoot   Float
  calibrationJson Json?

  createdAt       DateTime @default(now())

  @@unique([drawingId, page])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  entityType String
  entityId   String
  action     String
  metadata   Json?

  createdAt  DateTime @default(now())
}

enum SessionStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum MarkupStatus {
  OPEN
  PENDING
  RESOLVED
  VOID
}

enum MarkupType {
  TEXT
  HIGHLIGHT
  RECTANGLE
  CIRCLE
  CLOUD
  ARROW
  FREEHAND
  LINE
  LENGTH
  AREA
  COUNT
  STAMP
  PHOTO
  EQUIPMENT
}

enum MeasurementType {
  LENGTH
  AREA
  COUNT
}

// ─── Sprint 5: Collaboration ──────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  collabSessions CollaborationSession[]
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  role           String       // OrganizationRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   // ProjectRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model CollaborationSession {
  id             String       @id @default(cuid())
  planId         String
  projectId      String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  status         String       @default("active")
  createdBy      String
  endedBy        String?
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  participants SessionParticipant[]
  comments     Comment[]
  auditEvents  AuditEvent[]

  @@index([planId])
  @@index([projectId])
  @@index([organizationId])
  @@index([status])
}

model SessionParticipant {
  id        String               @id @default(cuid())
  sessionId String
  session   CollaborationSession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  role      String               // ProjectRole
  joinedAt  DateTime             @default(now())
  leftAt    DateTime?

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Comment {
  id         String               @id @default(cuid())
  sessionId  String
  session    CollaborationSession @relation(fields: [sessionId], references: [id])
  planId     String
  pageNumber Int?
  parentId   String?
  parent     Comment?             @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]            @relation("CommentReplies")
  pinJson    String?
  targetType String?
  targetId   String?
  authorId   String
  author     User                 @relation(fields: [authorId], references: [id])
  body       String
  status     String               @default("open")
  resolvedBy String?
  resolvedAt DateTime?
  deletedAt  DateTime?
  assigneeId String?
  assignee   User?                @relation("AssignedComments", fields: [assigneeId], references: [id])
  revision   Int                  @default(1)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  mentions Mention[]

  @@index([sessionId])
  @@index([planId, pageNumber])
  @@index([targetType, targetId])
  @@index([assigneeId])
  @@index([status])
}

model Mention {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation(fields: [mentionedUserId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
}

model AuditEvent {
  id                String               @id @default(cuid())
  organizationId    String
  projectId         String
  sessionId         String?
  session           CollaborationSession? @relation(fields: [sessionId], references: [id])
  actorId           String
  actor             User                 @relation("ActorAuditEvents", fields: [actorId], references: [id])
  actorName         String
  action            String
  aggregateType     String
  aggregateId       String
  previousRevision  Int?
  resultingRevision Int?
  patchJson         String?
  origin            String               @default("online")
  correlationId     String
  createdAt         DateTime             @default(now())

  @@index([organizationId])
  @@index([sessionId])
  @@index([aggregateType, aggregateId])
  @@index([actorId])
  @@index([createdAt])
}

model IdempotencyRecord {
  id        String   @id
  sessionId String
  actorId   String
  result    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([sessionId])
  @@index([expiresAt])
}

model RealtimeDeliveryFailure {
  id           String    @id @default(cuid())
  channel      String
  eventType    String
  eventJson    String
  attemptCount Int       @default(1)
  lastError    String
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([resolvedAt])
}

model PlanMarkup {
  id           String   @id @default(cuid())
  planId       String
  pageNumber   Int
  tool         String
  geometryJson String
  styleJson    String
  status       String   @default("open")
  locked       Boolean  @default(false)
  visible      Boolean  @default(true)
  zIndex       Int      @default(0)
  label        String?
  comment      String?
  authorName   String
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  revisions    MarkupRevision[]

  @@index([planId])
  @@index([planId, pageNumber])
  @@index([updatedAt])
}

model MarkupRevision {
  id           String     @id @default(cuid())
  markupId     String
  markup       PlanMarkup @relation(fields: [markupId], references: [id], onDelete: Cascade)
  revision     Int
  geometryJson String
  styleJson    String
  changedBy    String
  changedAt    DateTime   @default(now())

  @@index([markupId])
}

// ─── Sprint 3: Measurement Engine ────────────────────────────────────────────

model MeasurementCalibration {
  id                       String   @id @default(cuid())
  planId                   String
  pageNumber               Int?
  name                     String
  normalizedStartJson      String
  normalizedEndJson        String
  knownDistanceMillimeters Float
  pageUnitsPerMillimeter   Float
  unitSystem               String
  displayUnit              String
  precision                Int
  architecturalDenominator Int?
  authorName               String
  revision                 Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  measurements             PlanMeasurement[]

  @@index([planId])
  @@index([planId, pageNumber])
}

model PlanMeasurement {
  id            String                  @id @default(cuid())
  planId        String
  pageNumber    Int
  type          String
  calibrationId String?
  calibration   MeasurementCalibration? @relation(fields: [calibrationId], references: [id])
  geometryJson  String
  styleJson     String
  label         String?
  prefix        String?
  suffix        String?
  status        String                  @default("open")
  locked        Boolean                 @default(false)
  visible       Boolean                 @default(true)
  groupId       String?
  group         MeasurementGroup?       @relation(fields: [groupId], references: [id])
  zIndex        Int                     @default(0)
  authorName    String
  revision      Int                     @default(1)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  revisions     MeasurementRevision[]

  @@index([planId])
  @@index([planId, pageNumber])
  @@index([planId, pageNumber, type])
  @@index([calibrationId])
  @@index([groupId])
  @@index([updatedAt])
}

model MeasurementRevision {
  id            String          @id @default(cuid())
  measurementId String
  measurement   PlanMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  revision      Int
  geometryJson  String
  changedBy     String
  changedAt     DateTime        @default(now())

  @@index([measurementId])
}

model MeasurementGroup {
  id           String            @id @default(cuid())
  planId       String
  name         String
  color        String            @default("#F59E0B")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  measurements PlanMeasurement[]

  @@index([planId])
}

// ─── Sprint 4: HVAC Takeoff Engine ────────────────────────────────────────────

model HvacCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  category       String
  name           String
  abbreviation   String
  description    String?
  active         Boolean  @default(true)
  defaultUnit    String
  defaultColor   String   @default("#ff6a1a")
  defaultSymbol  String?
  keywords       String   // JSON array
  sortOrder      Int      @default(0)
  authorName     String
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  takeoffItems       TakeoffItem[]
  assemblyTriggers   TakeoffAssembly[]
  assemblyComponents AssemblyComponent[]

  @@index([organizationId, category, active])
  @@index([organizationId, active])
}

model TakeoffAssembly {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  active               Boolean  @default(true)
  triggerCatalogItemId String
  triggerItem          HvacCatalogItem @relation(fields: [triggerCatalogItemId], references: [id])
  authorName           String
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  components           AssemblyComponent[]
  applications         AssemblyApplication[]

  @@index([organizationId, active])
}

model AssemblyComponent {
  id            String          @id @default(cuid())
  assemblyId    String
  assembly      TakeoffAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   HvacCatalogItem @relation(fields: [catalogItemId], references: [id])
  unit          String
  ruleJson      String          // AssemblyRule JSON
  wastePercent  String          @default("0")
  sortOrder     Int             @default(0)

  @@index([assemblyId])
}

model AssemblyApplication {
  id           String          @id @default(cuid())
  assemblyId   String
  assembly     TakeoffAssembly @relation(fields: [assemblyId], references: [id])
  planId       String
  appliedAt    DateTime        @default(now())
  appliedBy    String

  takeoffItems TakeoffItem[]

  @@index([assemblyId])
  @@index([planId])
}

model TakeoffItem {
  id                    String               @id @default(cuid())
  planId                String
  pageNumber            Int?
  catalogItemId         String
  catalogItem           HvacCatalogItem      @relation(fields: [catalogItemId], references: [id])
  sourceJson            String               // TakeoffSource JSON
  unit                  String
  netQuantity           String
  wastePercent          String               @default("0")
  grossQuantity         String
  equipmentTag          String?
  sizeJson              String?              // TakeoffSize JSON
  material              String?
  systemId              String?
  system                ProjectSystem?       @relation(fields: [systemId], references: [id])
  zoneId                String?
  zone                  ProjectZone?         @relation(fields: [zoneId], references: [id])
  levelId               String?
  level                 ProjectLevel?        @relation(fields: [levelId], references: [id])
  phaseId               String?
  phase                 ProjectPhase?        @relation(fields: [phaseId], references: [id])
  groupId               String?
  group                 TakeoffGroup?        @relation(fields: [groupId], references: [id])
  assemblyApplicationId String?
  assemblyApplication   AssemblyApplication? @relation(fields: [assemblyApplicationId], references: [id])
  notes                 String?
  customFieldsJson      String               @default("{}")
  status                String               @default("open")
  locked                Boolean              @default(false)
  visible               Boolean              @default(true)
  authorName            String
  revision              Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  revisions             TakeoffItemRevision[]

  @@index([planId])
  @@index([planId, pageNumber])
  @@index([catalogItemId])
  @@index([systemId])
  @@index([zoneId])
  @@index([levelId])
  @@index([groupId])
  @@index([updatedAt])
}

model TakeoffItemRevision {
  id            String      @id @default(cuid())
  takeoffItemId String
  item          TakeoffItem @relation(fields: [takeoffItemId], references: [id], onDelete: Cascade)
  revision      Int
  snapshotJson  String
  changedBy     String
  changedAt     DateTime    @default(now())

  @@index([takeoffItemId])
}

model ProjectSystem {
  id           String        @id @default(cuid())
  planId       String
  name         String
  color        String        @default("#3B82F6")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  takeoffItems TakeoffItem[]

  @@index([planId])
}

model ProjectZone {
  id           String        @id @default(cuid())
  planId       String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  takeoffItems TakeoffItem[]

  @@index([planId])
}

model ProjectLevel {
  id           String        @id @default(cuid())
  planId       String
  name         String
  elevation    Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  takeoffItems TakeoffItem[]

  @@index([planId])
}

model ProjectPhase {
  id           String        @id @default(cuid())
  planId       String
  name         String
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  takeoffItems TakeoffItem[]

  @@index([planId])
}

model TakeoffGroup {
  id           String        @id @default(cuid())
  planId       String
  name         String
  color        String        @default("#F59E0B")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  takeoffItems TakeoffItem[]

  @@index([planId])
}

// ─── Sprint 6: Drawing Set Version Management ─────────────────────────────────

model DrawingSet {
  id               String   @id @default(cuid())
  projectId        String
  organizationId   String
  name             String
  discipline       String?
  currentVersionId String?  @unique
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions         DrawingSetVersion[]
  currentVersion   DrawingSetVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  comparisons      DrawingComparison[]
  jobs             ProcessingJob[]

  @@index([projectId])
  @@index([organizationId])
}

model DrawingSetVersion {
  id               String     @id @default(cuid())
  drawingSetId     String
  drawingSet       DrawingSet @relation(fields: [drawingSetId], references: [id])
  revisionName     String
  revisionNumber   String?
  issueDate        DateTime?
  receivedDate     DateTime?
  description      String?
  sourceFilename   String
  checksum         String
  uploadedBy       String
  status           String     @default("processing")
  pageCount        Int?
  processingError  String?
  pdfKey           String?
  revision         Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  pages            DrawingPageVersion[]
  currentForSet    DrawingSet?          @relation("CurrentVersion")
  baseComparisons  DrawingComparison[]  @relation("BaseVersion")
  compComparisons  DrawingComparison[]  @relation("ComparisonVersion")
  baseMatches      PageMatch[]          @relation("BaseVersion")
  compMatches      PageMatch[]          @relation("ComparisonVersion")
  jobs             ProcessingJob[]

  @@unique([drawingSetId, checksum])
  @@index([drawingSetId])
  @@index([status])
}

model DrawingPageVersion {
  id                    String             @id @default(cuid())
  versionId             String
  version               DrawingSetVersion  @relation(fields: [versionId], references: [id])
  drawingSetId          String
  pageIndex             Int
  sheetNumber           String?
  sheetTitle            String?
  discipline            String?
  revisionLabel         String?
  revisionDate          DateTime?
  widthPt               Float
  heightPt              Float
  nativeRotation        Int                @default(0)
  contentChecksum       String?
  thumbnailKey          String?
  renderKey             String?
  processingStatus      String             @default("pending")
  processingError       String?
  userConfirmedMetadata Boolean            @default(false)
  revision              Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  baseMatches           PageMatch[]        @relation("BasePage")
  comparisonMatches     PageMatch[]        @relation("ComparisonPage")

  @@unique([versionId, pageIndex])
  @@index([versionId])
  @@index([drawingSetId])
}

model PageMatch {
  id                  String              @id @default(cuid())
  baseVersionId       String
  baseVersion         DrawingSetVersion   @relation("BaseVersion", fields: [baseVersionId], references: [id])
  comparisonVersionId String
  comparisonVersion   DrawingSetVersion   @relation("ComparisonVersion", fields: [comparisonVersionId], references: [id])
  drawingSetId        String
  basePageId          String?
  basePage            DrawingPageVersion? @relation("BasePage", fields: [basePageId], references: [id])
  comparisonPageId    String?
  comparisonPage      DrawingPageVersion? @relation("ComparisonPage", fields: [comparisonPageId], references: [id])
  status              String
  confidence          Float
  matchReasonsJson    String
  userConfirmed       Boolean             @default(false)
  revision            Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  alignments          PageAlignment[]
  comparisons         DrawingComparison[]

  @@index([baseVersionId])
  @@index([comparisonVersionId])
  @@index([drawingSetId])
}

model PageAlignment {
  id            String      @id @default(cuid())
  pageMatchId   String
  pageMatch     PageMatch   @relation(fields: [pageMatchId], references: [id])
  method        String
  matrixJson    String
  qualityScore  Float?
  residualError Float?
  userConfirmed Boolean     @default(false)
  confirmedBy   String?
  confirmedAt   DateTime?
  revision      Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  comparisons   DrawingComparison[]

  @@index([pageMatchId])
}

model DrawingComparison {
  id                  String             @id @default(cuid())
  baseVersionId       String
  baseVersion         DrawingSetVersion  @relation("BaseVersion", fields: [baseVersionId], references: [id])
  comparisonVersionId String
  comparisonVersion   DrawingSetVersion  @relation("ComparisonVersion", fields: [comparisonVersionId], references: [id])
  drawingSetId        String
  drawingSet          DrawingSet         @relation(fields: [drawingSetId], references: [id])
  pageMatchId         String
  pageMatch           PageMatch          @relation(fields: [pageMatchId], references: [id])
  alignmentId         String?
  alignment           PageAlignment?     @relation(fields: [alignmentId], references: [id])
  jobId               String?
  status              String             @default("pending")
  previewKey          String?
  maskKey             String?
  overlayKey          String?
  metricsJson         String?
  idempotencyKey      String             @unique
  revision            Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  regions               ChangeRegion[]
  carryForwardDecisions CarryForwardDecision[]
  jobs                  ProcessingJob[]

  @@index([drawingSetId])
  @@index([baseVersionId])
  @@index([status])
}

model ChangeRegion {
  id                String            @id @default(cuid())
  comparisonId      String
  comparison        DrawingComparison @relation(fields: [comparisonId], references: [id])
  boundsJson        String
  kind              String
  changedPixelCount Int
  strength          Float
  reviewStatus      String            @default("unreviewed")
  revision          Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([comparisonId])
  @@index([reviewStatus])
}

model ProcessingJob {
  id             String             @id @default(cuid())
  type           String
  organizationId String
  projectId      String
  drawingSetId   String?
  drawingSet     DrawingSet?        @relation(fields: [drawingSetId], references: [id])
  versionId      String?
  version        DrawingSetVersion? @relation(fields: [versionId], references: [id])
  comparisonId   String?
  comparison     DrawingComparison? @relation(fields: [comparisonId], references: [id])
  state          String             @default("queued")
  progress       Int                @default(0)
  stage          String?
  errorCode      String?
  errorMessage   String?
  maxAttempts    Int                @default(3)
  attemptCount   Int                @default(0)
  nextAttemptAt  DateTime?
  correlationId  String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  attempts       ProcessingJobAttempt[]

  @@index([type, state])
  @@index([organizationId])
  @@index([versionId])
  @@index([comparisonId])
  @@index([nextAttemptAt])
}

model ProcessingJobAttempt {
  id            String        @id @default(cuid())
  jobId         String
  job           ProcessingJob @relation(fields: [jobId], references: [id])
  attemptNumber Int
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  state         String
  errorCode     String?
  errorMessage  String?

  @@index([jobId])
}

model CarryForwardDecision {
  id                  String            @id @default(cuid())
  comparisonId        String
  comparison          DrawingComparison @relation(fields: [comparisonId], references: [id])
  sourceAggregateType String
  sourceAggregateId   String
  targetAggregateId   String?
  decision            String
  transformJson       String?
  reason              String?
  actorId             String
  decidedAt           DateTime          @default(now())
  idempotencyKey      String            @unique

  @@index([comparisonId])
  @@index([sourceAggregateType, sourceAggregateId])
}

// ─── Sprint 7: Estimating & Exports ──────────────────────────────────────────

model Estimate {
  id               String    @id @default(cuid())
  organizationId   String
  projectId        String
  estimateNumber   String
  name             String
  description      String?
  currency         String    @default("USD")
  status           String    @default("draft")
  currentVersionId String?   @unique
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  versions       EstimateVersion[]
  currentVersion EstimateVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
}

model EstimateVersion {
  id                       String   @id @default(cuid())
  estimateId               String
  estimate                 Estimate @relation(fields: [estimateId], references: [id])
  versionNumber            Int
  status                   String   @default("draft")
  currency                 String
  calculationPolicyVersion String   @default("1")
  createdBy                String
  submittedBy              String?
  approvedBy               String?
  lockedBy                 String?
  submittedAt              DateTime?
  approvedAt               DateTime?
  lockedAt                 DateTime?
  revision                 Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  currentForEstimate EstimateVersion? @relation("CurrentVersion")
  sections           EstimateSection[]
  adjustments        EstimateVersionAdjustment[]
  alternates         EstimateAlternate[]
  exclusions         EstimateExclusion[]
  qualifications     EstimateQualification[]
  reviewDecisions    EstimateReviewDecision[]
  exportJobs         ExportJob[]

  @@index([estimateId])
  @@index([status])
}

model EstimateSection {
  id          String           @id @default(cuid())
  versionId   String
  version     EstimateVersion  @relation(fields: [versionId], references: [id])
  parentId    String?
  parent      EstimateSection? @relation("SectionChildren", fields: [parentId], references: [id])
  children    EstimateSection[] @relation("SectionChildren")
  name        String
  description String?
  sortOrder   Int              @default(0)
  depth       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lines EstimateLine[]

  @@index([versionId])
  @@index([parentId])
}

model EstimateLine {
  id                  String                      @id @default(cuid())
  versionId           String
  sectionId           String?
  section             EstimateSection?            @relation(fields: [sectionId], references: [id])
  costCode            String?
  description         String
  category            String                      @default("material")
  quantity            String
  unit                String
  unitMaterialCost    String                      @default("0")
  laborHoursPerUnit   String                      @default("0")
  burdenedLaborRate   String                      @default("0")
  unitEquipmentCost   String                      @default("0")
  unitSubcontractCost String                      @default("0")
  unitOtherCost       String                      @default("0")
  wastePercent        String                      @default("0")
  notes               String?
  included            Boolean                     @default(true)
  isAlternate         Boolean                     @default(false)
  alternateId         String?
  sortOrder           Int                         @default(0)
  sourceSnapshotId    String?
  snapshot            EstimateLineSourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id])
  revision            Int                         @default(1)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([versionId])
  @@index([sectionId])
  @@index([alternateId])
}

model EstimateLineSourceSnapshot {
  id               String   @id @default(cuid())
  takeoffItemId    String
  takeoffRevision  Int
  quantity         String
  unit             String
  drawingVersionId String?
  classifications  String
  snapshotAt       DateTime @default(now())
  isStale          Boolean  @default(false)

  lines EstimateLine[]

  @@index([takeoffItemId])
}

model EstimateVersionAdjustment {
  id             String          @id @default(cuid())
  versionId      String
  version        EstimateVersion @relation(fields: [versionId], references: [id])
  kind           String
  label          String
  rate           String?
  fixedAmount    String?
  currency       String?
  basis          String
  taxable        Boolean         @default(false)
  sortOrder      Int             @default(0)
  policySnapshot String

  @@index([versionId])
}

model EstimateAlternate {
  id                    String          @id @default(cuid())
  versionId             String
  version               EstimateVersion @relation(fields: [versionId], references: [id])
  name                  String
  description           String?
  kind                  String          @default("add")
  included              Boolean         @default(false)
  mutuallyExclusiveGroup String?
  sortOrder             Int             @default(0)

  @@index([versionId])
}

model EstimateExclusion {
  id        String          @id @default(cuid())
  versionId String
  version   EstimateVersion @relation(fields: [versionId], references: [id])
  text      String
  scope     String          @default("estimate")
  sectionId String?
  sortOrder Int             @default(0)
}

model EstimateQualification {
  id        String          @id @default(cuid())
  versionId String
  version   EstimateVersion @relation(fields: [versionId], references: [id])
  text      String
  internal  Boolean         @default(false)
  sortOrder Int             @default(0)
}

model EstimateReviewDecision {
  id        String          @id @default(cuid())
  versionId String
  version   EstimateVersion @relation(fields: [versionId], references: [id])
  actorId   String
  action    String
  comment   String?
  decidedAt DateTime        @default(now())

  @@index([versionId])
}

model CostCode {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  description    String
  category       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model LaborRateSchedule {
  id             String   @id @default(cuid())
  organizationId String
  classification String
  burdenedRate   String
  currency       String   @default("USD")
  effectiveDate  DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([effectiveDate])
}

model ExportTemplate {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  exportType       String
  isCustomerFacing Boolean  @default(false)
  configJson       String
  createdBy        String
  active           Boolean  @default(true)
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
}

model ExportJob {
  id              String           @id @default(cuid())
  organizationId  String
  projectId       String
  requestedBy     String
  exportType      String
  status          String           @default("queued")
  sourceIds       String
  templateId      String?
  parametersJson  String
  idempotencyKey  String           @unique
  progress        Int              @default(0)
  stage           String?
  errorCode       String?
  errorMessage    String?
  attemptCount    Int              @default(0)
  maxAttempts     Int              @default(3)
  nextAttemptAt   DateTime?
  versionId       String?
  estimateVersion EstimateVersion? @relation(fields: [versionId], references: [id])
  outputKey       String?
  outputChecksum  String?
  outputSizeBytes Int?
  expiresAt       DateTime?
  correlationId   String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
}

model AggregateLineage {
  id                     String   @id @default(cuid())
  sourceAggregateType    String
  sourceAggregateId      String
  sourceVersionId        String
  targetAggregateType    String
  targetAggregateId      String
  targetVersionId        String
  carryForwardDecisionId String
  transformJson          String?
  createdAt              DateTime @default(now())

  @@unique([sourceAggregateType, sourceAggregateId, targetVersionId])
  @@index([sourceAggregateType, sourceAggregateId])
  @@index([targetAggregateType, targetAggregateId])
  @@index([carryForwardDecisionId])
}
