generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  name        String?
  email       String        @unique
  markups     Markup[]
  sessions    SessionUser[]
  activities  Activity[]
  createdAt   DateTime      @default(now())
}

model Project {
  id            String          @id @default(cuid())
  name          String
  address       String?
  projectNumber String?
  status        String          @default("active")
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  drawings      Drawing[]
  sessions      StudioSession[]
}

model Drawing {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  drawingNumber  String?
  title          String
  discipline     String?
  currentVersion Int              @default(1)
  pageCount      Int              @default(1)
  thumbnailUrl   String?

  versions       DrawingVersion[]
  markups        Markup[]
  measurements   Measurement[]
  scales         DrawingScale[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model DrawingVersion {
  id         String   @id @default(cuid())
  drawingId  String
  drawing    Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  version    Int
  fileUrl    String
  uploadedBy String?
  notes      String?
  uploadedAt DateTime @default(now())

  @@unique([drawingId, version])
}

model StudioSession {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  status    SessionStatus @default(ACTIVE)

  users     SessionUser[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SessionUser {
  id        String        @id @default(cuid())
  sessionId String
  userId    String

  session   StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  userName  String?
  color     String?
  joinedAt  DateTime      @default(now())
  lastSeen  DateTime      @default(now())

  @@unique([sessionId, userId])
}

model Markup {
  id          String       @id @default(cuid())

  drawingId   String
  drawing     Drawing      @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  userId      String
  user        User         @relation(fields: [userId], references: [id])

  page        Int          @default(1)
  type        MarkupType

  x           Float        @default(0)
  y           Float        @default(0)
  width       Float?
  height      Float?
  points      Json?
  text        String?
  color       String       @default("#EF4444")
  strokeWidth Float        @default(2)

  label       String?
  assignedTo  String?
  status      MarkupStatus @default(OPEN)
  comment     String?
  resolvedAt  DateTime?

  metadata    Json?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Measurement {
  id         String          @id @default(cuid())

  drawingId  String
  drawing    Drawing         @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  page       Int             @default(1)
  type       MeasurementType

  points     Json
  value      Float
  unit       String          @default("ft")
  label      String?

  authorName String?
  authorId   String?

  createdAt  DateTime        @default(now())
}

model DrawingScale {
  id              String   @id @default(cuid())
  drawingId       String
  drawing         Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  page            Int      @default(1)
  pixelsPerFoot   Float
  calibrationJson Json?

  createdAt       DateTime @default(now())

  @@unique([drawingId, page])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  entityType String
  entityId   String
  action     String
  metadata   Json?

  createdAt  DateTime @default(now())
}

enum SessionStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum MarkupStatus {
  OPEN
  PENDING
  RESOLVED
  VOID
}

enum MarkupType {
  TEXT
  HIGHLIGHT
  RECTANGLE
  CIRCLE
  CLOUD
  ARROW
  FREEHAND
  LINE
  LENGTH
  AREA
  COUNT
  STAMP
  PHOTO
  EQUIPMENT
}

enum MeasurementType {
  LENGTH
  AREA
  COUNT
}

model PlanMarkup {
  id           String   @id @default(cuid())
  planId       String
  pageNumber   Int
  tool         String
  geometryJson String
  styleJson    String
  status       String   @default("open")
  locked       Boolean  @default(false)
  visible      Boolean  @default(true)
  zIndex       Int      @default(0)
  label        String?
  comment      String?
  authorName   String
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  revisions    MarkupRevision[]

  @@index([planId])
  @@index([planId, pageNumber])
  @@index([updatedAt])
}

model MarkupRevision {
  id           String     @id @default(cuid())
  markupId     String
  markup       PlanMarkup @relation(fields: [markupId], references: [id], onDelete: Cascade)
  revision     Int
  geometryJson String
  styleJson    String
  changedBy    String
  changedAt    DateTime   @default(now())

  @@index([markupId])
}

// ─── Sprint 3: Measurement Engine ────────────────────────────────────────────

model MeasurementCalibration {
  id                       String   @id @default(cuid())
  planId                   String
  pageNumber               Int?
  name                     String
  normalizedStartJson      String
  normalizedEndJson        String
  knownDistanceMillimeters Float
  pageUnitsPerMillimeter   Float
  unitSystem               String
  displayUnit              String
  precision                Int
  architecturalDenominator Int?
  authorName               String
  revision                 Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  measurements             PlanMeasurement[]

  @@index([planId])
  @@index([planId, pageNumber])
}

model PlanMeasurement {
  id            String                  @id @default(cuid())
  planId        String
  pageNumber    Int
  type          String
  calibrationId String?
  calibration   MeasurementCalibration? @relation(fields: [calibrationId], references: [id])
  geometryJson  String
  styleJson     String
  label         String?
  prefix        String?
  suffix        String?
  status        String                  @default("open")
  locked        Boolean                 @default(false)
  visible       Boolean                 @default(true)
  groupId       String?
  group         MeasurementGroup?       @relation(fields: [groupId], references: [id])
  zIndex        Int                     @default(0)
  authorName    String
  revision      Int                     @default(1)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  revisions     MeasurementRevision[]

  @@index([planId])
  @@index([planId, pageNumber])
  @@index([planId, pageNumber, type])
  @@index([calibrationId])
  @@index([groupId])
  @@index([updatedAt])
}

model MeasurementRevision {
  id            String          @id @default(cuid())
  measurementId String
  measurement   PlanMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  revision      Int
  geometryJson  String
  changedBy     String
  changedAt     DateTime        @default(now())

  @@index([measurementId])
}

model MeasurementGroup {
  id           String            @id @default(cuid())
  planId       String
  name         String
  color        String            @default("#F59E0B")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  measurements PlanMeasurement[]

  @@index([planId])
}
